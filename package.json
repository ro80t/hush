{
  "name": "hush",
  "version": "1.1.0",
  "private": true,
  "description": "Self-documenting naming and minimal, high-signal comments for AI coding agents.",
  "license": "MIT",
  "keywords": ["comments", "code-style", "documentation", "self-documenting-code", "naming"],
  "author": {
    "name": "ROBOT"
  },
  "homepage": "https://github.com/ro80t/hush",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ro80t/hush.git"
  },
  "bugs": {
    "url": "https://github.com/ro80t/hush/issues"
  },
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-rules.mjs",
    "check": "node scripts/sync-rules.mjs && git diff --exit-code GEMINI.md gemini-extension.json .github/copilot-instructions.md .cursor .windsurf .clinerules .kiro .qoder .agents .claude .claude-plugin .codex-plugin",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "hushManifests": {
    "category": "code-quality",
    "codexSkillsPath": "./skills/",
    "codexInstallPolicy": "AVAILABLE",
    "geminiContextFileName": "GEMINI.md",
    "claudeMarketplaceSchema": "https://anthropic.com/claude-code/marketplace.schema.json"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
